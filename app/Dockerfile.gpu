FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-distutils curl ca-certificates \
    && curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.11 /tmp/get-pip.py \
    && rm -rf /tmp/get-pip.py /var/lib/apt/lists/*

RUN useradd --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /home/app/.cache/huggingface \
    && chown -R app:app /home/app

COPY requirements-gpu.txt .
RUN python3.11 -m pip install --no-cache-dir -r requirements-gpu.txt \
    && python3.11 -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128

COPY main.py schemas.py .

USER app

EXPOSE 8000

CMD ["python3.11", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
